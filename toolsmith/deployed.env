# Where this is deployed. Committed on purpose: none of it is secret, and
# requiring three exports before anything runs is how a demo gets a
# RuntimeError in front of an audience.
#
# Anything already set in the environment wins, so overriding one value for a
# local experiment does not mean restating the others.

TOOLSMITH_SANDBOX_URL=https://toolsmith-sandbox-111259597572.us-central1.run.app
TOOLSMITH_PROJECT_NUMBER=111259597572
TOOLSMITH_SANDBOX_REGION=us-central1
TOOLSMITH_SANDBOX_SERVICE=toolsmith-sandbox
TOOLSMITH_CATALOG=fixtures/catalog/demo.json
TOOLSMITH_FIXTURE=https://toolsmith-github-111259597572.us-central1.run.app/mcp
