# Copy to .env and fill in. Never commit .env.

# --- Gemini access (pick ONE path) ---
# Path A: Gemini API (simplest for local dev).
#
# AI Studio issues this as a "Gemini API key"; GEMINI_API_KEY and
# GOOGLE_API_KEY are both read by google-genai, which prefers GOOGLE_API_KEY
# and warns if both are set. Set only one.
#
# On this machine the key is kept outside the repo at
# ~/keys/ToolSmith/ToolSmith.env and loaded automatically by toolsmith/config.py.
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=0

# Path B: Vertex AI / Google Agent Platform (required for the Cloud Run demo)
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Cloud Run sandbox ---
# Region and service used for isolated trial calls against candidate MCP servers.
TOOLSMITH_SANDBOX_REGION=us-central1
TOOLSMITH_SANDBOX_SERVICE=toolsmith-sandbox

# --- Demo target ---
# The GitHub repo the agent acts on once a tool is approved and attached.
TOOLSMITH_DEMO_REPO=CatDidIt-Studio/Toolsmith
